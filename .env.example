# ─────────────────────────────────────────────────────────────
# Nexora — Environment Variables
# Copy this file to `.env` for local dev, or set these in your
# host (Vercel → Project Settings → Environment Variables).
# ─────────────────────────────────────────────────────────────

# Database (REQUIRED) — any PostgreSQL URL.
# Local dev:
#   DATABASE_URL="postgresql://postgres:postgres@localhost:5432/businessos?schema=public"
# Hosted (Neon / Vercel Postgres) — use the DIRECT (non-pooled) connection string:
#   DATABASE_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/businessos?schema=public"

# Auth.js (REQUIRED)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET="replace-with-a-secure-random-string-min-32-chars"
# On Vercel this must be your production domain, e.g. https://ai-business-os-eight.vercel.app
AUTH_URL="http://localhost:3000"

# App (REQUIRED)
NEXT_PUBLIC_APP_NAME="Nexora"
# Production domain, e.g. https://ai-business-os-eight.vercel.app
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Email (optional — used for verification / password reset)
EMAIL_SERVER_HOST="smtp.example.com"
EMAIL_SERVER_PORT="587"
EMAIL_SERVER_USER="apikey"
EMAIL_SERVER_PASSWORD=""
EMAIL_FROM="noreply@businessos.ai"
